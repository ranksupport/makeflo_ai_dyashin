  "main": "index.js",
  "scripts": {
    "start": " webpack-dev-server --open --config ./webpack.dev.js --mode development  --hot",
    "build:dev": "webpack --config ./webpack.dev.js --mode production",
    "build:prod": "webpack --config ./webpack.prod.js --mode production",
    "build:staging": "webpack --config ./webpack.staging.js --mode production",
    "build:preprod": "webpack --config ./webpack.preprod.js --mode production",
    "deploy:staging": "npm run build:staging && bestzip staging.zip dist/*",
    "deploy:preprod": "npm run build:preprod && bestzip preprod.zip dist/*",
    "deploy:prod": "npm run build:prod && bestzip production.zip dist/*",
    "deploy:all": "npm run deploy:staging && npm run deploy:prod && npm run deploy:preprod",
    "mockserver": "json-server --watch ./mock/db.json --port 4004"
  },
